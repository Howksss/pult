meta {
  name: Блок по идентификатору
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/blocks/{{blockId}}
  body: none
  auth: none
}

headers {
  X-API-Key: {{ownerKey}}
}

tests {
  test("200 и тот же блок", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(bru.getVar("blockId"));
    expect(res.getBody().reason).to.equal("Проверки не настроены");
  });
}
