meta {
  name: 422 - начало периода позже конца
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/checks/{{posCheckId}}/results?since=2026-11-20T00:00:00Z&until=2026-11-19T00:00:00Z
  body: none
  auth: none
}

headers {
  X-API-Key: {{ownerKey}}
}

tests {
  test("422 и ошибка в формате RFC 9457", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    const body = res.getBody();
    expect(body).to.have.all.keys(...Object.keys(body));
    expect(body.type).to.match(/\/validation$/);
    expect(body.status).to.equal(422);
    expect(body.title).to.be.a("string");
    expect(body.detail).to.be.a("string");
  });
}
