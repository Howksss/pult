meta {
  name: 404 - несуществующий блок
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/blocks/999999
  body: none
  auth: none
}

headers {
  X-API-Key: {{ownerKey}}
}

tests {
  test("404 и ошибка в формате RFC 9457", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    const body = res.getBody();
    expect(body).to.have.all.keys(...Object.keys(body));
    expect(body.type).to.match(/\/not-found$/);
    expect(body.status).to.equal(404);
    expect(body.title).to.be.a("string");
    expect(body.detail).to.be.a("string");
  });
}
