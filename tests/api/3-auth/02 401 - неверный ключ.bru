meta {
  name: 401 - неверный ключ
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/projects
  body: none
  auth: none
}

headers {
  X-API-Key: pult_not-a-real-key
}

tests {
  test("401 и ошибка в формате RFC 9457", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    const body = res.getBody();
    expect(body).to.have.all.keys(...Object.keys(body));
    expect(body.type).to.match(/\/unauthenticated$/);
    expect(body.status).to.equal(401);
    expect(body.title).to.be.a("string");
    expect(body.detail).to.be.a("string");
  });
}
