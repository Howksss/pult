@startuml er_diagram
hide circle
skinparam linetype ortho
skinparam defaultFontName "Arial"
skinparam dpi 150
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
  HeaderBackgroundColor #E8EEF7
}

title Pult — модель данных (ER), схема 0011

entity app_user {
  * id : integer <<PK>>
  --
  * email : varchar(255) <<UQ>>
  * full_name : varchar(150)
  * password_hash : varchar(255)
  * created_at : timestamptz
}

entity user_session {
  * id : integer <<PK>>
  --
  * user_id : integer <<FK>>
  * token_hash : varchar(64) <<UQ>>
  * expires_at : timestamptz
  * created_at : timestamptz
}

entity api_key {
  * id : integer <<PK>>
  --
  * user_id : integer <<FK>>
  * name : varchar(100)
  * prefix : varchar(16)
  * token_hash : varchar(64) <<UQ>>
  * created_at : timestamptz
  * expires_at : timestamptz
  last_used_at : timestamptz
}

entity project {
  * id : integer <<PK>>
  --
  * name : varchar(150)
  description : text
  * repo_full_name : varchar(200)
  * default_branch : varchar(100)
  probe_token_hash : varchar(64) <<UQ>>
  * created_at : timestamptz
}

entity project_member {
  * project_id : integer <<PK, FK>>
  * user_id : integer <<PK, FK>>
  --
  * role : member_role
}

entity block {
  * id : integer <<PK>>
  --
  * project_id : integer <<FK>>
  * kind : block_kind
  * name : varchar(100)
  description : text
  * pos_x : double precision
  * pos_y : double precision
  * created_at : timestamptz
}

entity block_link {
  * id : integer <<PK>>
  --
  * source_block_id : integer <<FK>>
  * target_block_id : integer <<FK>>
  label : varchar(100)
}

entity block_scope {
  * id : integer <<PK>>
  --
  * block_id : integer <<FK>>
  * path_glob : varchar(300)
  * access : scope_access
}

entity health_check {
  * id : integer <<PK>>
  --
  * block_id : integer <<FK>>
  * method : check_method
  * target : varchar(500)
  * interval_sec : integer
  * timeout_sec : integer
  name : varchar(120)
  * config : jsonb
  * enabled : boolean
}

entity check_result {
  * id : integer <<PK>>
  --
  * health_check_id : integer <<FK>>
  * checked_at : timestamptz
  * status : check_status
  latency_ms : integer
  message : text
  error_kind : varchar(40)
  details : jsonb
}

entity agent_task {
  * id : integer <<PK>>
  --
  * block_id : integer <<FK>>
  * author_id : integer <<FK>>
  * title : varchar(200)
  * status : task_status
  finished_at : timestamptz
  * created_at : timestamptz
}

entity task_message {
  * id : integer <<PK>>
  --
  * task_id : integer <<FK>>
  * role : message_role
  * content : jsonb
  input_tokens : integer
  output_tokens : integer
  * created_at : timestamptz
}

entity change_request {
  * id : integer <<PK>>
  --
  * task_id : integer <<FK, UQ>>
  * branch_name : varchar(200)
  * pr_number : integer
  * status : cr_status
  reviewer_id : integer <<FK>>
  reviewed_at : timestamptz
}

entity deployment {
  * id : integer <<PK>>
  --
  * change_request_id : integer <<FK>>
  * commit_sha : char(40)
  * status : deploy_status
  * started_at : timestamptz
  finished_at : timestamptz
}

entity audit_event {
  * id : integer <<PK>>
  --
  user_id : integer <<FK>>
  block_id : integer <<FK>>
  * action : varchar(100)
  payload : jsonb
  * created_at : timestamptz
}

app_user ||--o{ user_session
app_user ||--o{ api_key
app_user ||--o{ project_member
project ||--o{ project_member
project ||--o{ block
block ||--o{ block_link : "источник"
block ||--o{ block_link : "приёмник"
block ||--o{ block_scope
block ||--o{ health_check
health_check ||--o{ check_result
block ||--o{ agent_task
app_user ||--o{ agent_task : "автор"
agent_task ||--o{ task_message
agent_task ||--o| change_request
app_user |o--o{ change_request : "ревьюер"
change_request ||--o{ deployment
app_user |o--o{ audit_event
block |o--o{ audit_event
@enduml
