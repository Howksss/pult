{
  "name": "Pult: ежедневная сводка по блокам",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "a1f0c1d2-0001-4000-8000-000000000001",
      "name": "Каждый день в 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.PULT_URL }}/api/v1/projects/{{ $env.PULT_PROJECT_ID }}/graph",
        "options": {
          "timeout": 10000
        }
      },
      "id": "a1f0c1d2-0002-4000-8000-000000000002",
      "name": "Граф проекта",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "jsCode": "const graph = $input.first().json;\nconst labels = { ok: 'работает', warn: 'предупреждение', fail: 'сбой', unknown: 'нет данных' };\nconst problems = graph.blocks.filter((block) => block.status !== 'ok');\nconst lines = problems.map((block) => `• ${block.name}: ${labels[block.status]}`);\nconst text = problems.length\n  ? `Сводка Pult: ${problems.length} из ${graph.blocks.length} блоков требуют внимания\\n${lines.join('\\n')}`\n  : `Сводка Pult: все ${graph.blocks.length} блоков работают`;\nreturn [{ json: { text, problems: problems.length } }];"
      },
      "id": "a1f0c1d2-0003-4000-8000-000000000003",
      "name": "Текст сводки",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "chatId": "={{ $env.PULT_TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "disable_web_page_preview": true
        }
      },
      "id": "a1f0c1d2-0004-4000-8000-000000000004",
      "name": "Отправить в Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [720, 0],
      "credentials": {
        "telegramApi": {
          "id": "pult-telegram",
          "name": "Pult Telegram bot"
        }
      }
    }
  ],
  "connections": {
    "Каждый день в 09:00": {
      "main": [[{ "node": "Граф проекта", "type": "main", "index": 0 }]]
    },
    "Граф проекта": {
      "main": [[{ "node": "Текст сводки", "type": "main", "index": 0 }]]
    },
    "Текст сводки": {
      "main": [[{ "node": "Отправить в Telegram", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Moscow"
  }
}
